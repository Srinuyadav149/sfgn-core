  "visibility": "pub"
  "signature": "pub fn decode_flat_stem(encoded_stem: &str) -> PathBuf"
  "doc": "Decodes a flat `:`-delimited filename stem (without `.sfgn`) back to a relative `PathBuf`:\n- `src:main.rs` -> `src/main.rs`"
  "code": """rust
pub fn decode_flat_stem(encoded_stem: &str) -> PathBuf {
    let rel = encoded_stem.replace(':', "/");
    PathBuf::from(rel)
}
  """

"fn decode_flat_artifact_path":
  "kind": "fn"
  "language": "rust"
  "source_file": "src/flat_path.rs"
  "line_span": [68, 78]
  "visibility": "pub"
  "signature": "pub fn decode_flat_artifact_path(artifact_rel: &str) -> Option<PathBuf>"
  "doc": "Decodes a workspace-relative flat artifact path (e.g. `sfgn-codes/src:main.rs.sfgn`\nor `sfgn-docs/resources:releasing.md.sfgn`) back into its source `PathBuf`."
  "code": """rust
pub fn decode_flat_artifact_path(artifact_rel: &str) -> Option<PathBuf> {
    let norm = artifact_rel.replace('\\', "/");
    let after_dir = norm
        .strip_prefix("sfgn-codes/")
        .or_else(|| norm.strip_prefix("sfgn-docs/"))?;
    let stem = after_dir.strip_suffix(".sfgn")?;
    if stem.is_empty() {
        return None;
    }
    Some(decode_flat_stem(stem))
}
  """
  >> "fn decode_flat_stem"

"fn flat_code_artifact_rel":
  "kind": "fn"
