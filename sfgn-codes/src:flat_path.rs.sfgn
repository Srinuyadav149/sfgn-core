  "doc": "Returns the SFGN portal target string for a code file (`\"sfgn-codes/src:main.rs.sfgn\"`)."
  "code": """rust
pub fn flat_code_portal(rel_source_path: &Path) -> String {
    format!(
        "{}/{}.sfgn",
        CODE_GRAPH_DIR,
        encode_flat_rel_path(rel_source_path)
    )
}
  """

