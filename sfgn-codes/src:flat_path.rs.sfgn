  "visibility": "pub"
  "signature": "pub fn encode_flat_rel_path(rel_path: &Path) -> String"
  "doc": "Encodes a workspace-relative path into a flat filename stem using `:` as separator:\n- `src/main.rs` -> `src:main.rs`\n- `examples/no-modules/main.rs` -> `examples:no-modules:main.rs`"
  "code": """rust
pub fn encode_flat_rel_path(rel_path: &Path) -> String {
    let normalized = normalize_rel_slashes(rel_path);
    normalized.replace('/', ":")
}
  """
