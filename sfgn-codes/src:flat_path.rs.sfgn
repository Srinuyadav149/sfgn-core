"enum FlatArtifactDomain":
  "kind": "enum"
  "language": "rust"
  "source_file": "src/flat_path.rs"
  "line_span": [14, 21]
  "visibility": "pub"
  "signature": "pub enum FlatArtifactDomain"
  "doc": "Target SFGN artifact category for a workspace-relative source file."
  "code": """rust
pub enum FlatArtifactDomain {
    /// Hydrates into `sfgn-codes/<encoded>.sfgn`.
    Code,
    /// Hydrates into `sfgn-docs/<encoded>.sfgn` (Markdown or media proxy).
    DocOrMedia,
    /// Tracked only inside `fs.sfgn` (no separate hydrated graph).
    FsOnly,
}
  """

"fn is_generated_sfgn_artifact":
  "kind": "fn"
  "language": "rust"
  "source_file": "src/flat_path.rs"
  "line_span": [25, 34]
  "visibility": "pub"
  "signature": "pub fn is_generated_sfgn_artifact(rel_path: &Path) -> bool"
  "doc": "Returns `true` if `rel_path` points to a generated SFGN root artifact\n(`fs.sfgn`, `sfgn-codes/...`, or `sfgn-docs/...`) that extractors must skip."
  "code": """rust
pub fn is_generated_sfgn_artifact(rel_path: &Path) -> bool {
    let Some(first) = rel_path.components().find_map(|c| match c {
        Component::Normal(os) => os.to_str(),
        _ => None,
    }) else {
        return false;
    };

    matches!(first, FS_GRAPH_FILE | CODE_GRAPH_DIR | DOC_GRAPH_DIR)
}
  """

"fn classify_workspace_file":
  "kind": "fn"
  "language": "rust"
  "source_file": "src/flat_path.rs"
  "line_span": [37, 49]
  "visibility": "pub"
  "signature": "pub fn classify_workspace_file(rel_path: &Path) -> FlatArtifactDomain"
  "doc": "Classifies a workspace-relative file path into its flat hydration domain."
  "code": """rust
pub fn classify_workspace_file(rel_path: &Path) -> FlatArtifactDomain {
    let Some(ext) = rel_path.extension().and_then(|e| e.to_str()) else {
        return FlatArtifactDomain::FsOnly;
    };

    match ext.to_ascii_lowercase().as_str() {
        "rs" | "py" | "ts" | "tsx" | "js" | "jsx" => FlatArtifactDomain::Code,
        "md" | "markdown" | "png" | "jpg" | "jpeg" | "gif" | "webp" | "wav" | "pdf" | "svg" => {
            FlatArtifactDomain::DocOrMedia
        }
        _ => FlatArtifactDomain::FsOnly,
    }
}
  """
  >> "enum FlatArtifactDomain"

