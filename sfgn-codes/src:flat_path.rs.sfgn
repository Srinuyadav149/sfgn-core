  "signature": "pub fn flat_code_artifact_rel(rel_source_path: &Path) -> PathBuf"
  "doc": "Returns the workspace-relative artifact path for a code file:\n`src/main.rs` -> `sfgn-codes/src:main.rs.sfgn`"
  "code": """rust
pub fn flat_code_artifact_rel(rel_source_path: &Path) -> PathBuf {
    PathBuf::from(CODE_GRAPH_DIR).join(format!("{}.sfgn", encode_flat_rel_path(rel_source_path)))
}
  """

